generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Table {
  id          Int           @id @default(autoincrement())
  name        String
  qrCode      String?
  orders      Order[]
  calls       CallRequest[]
  paymentReqs PaymentRequest[]
  ratings     Rating[]
  staffCalls  StaffCall[]
}

model Category {
  id    Int        @id @default(autoincrement())
  name  String
  sort  Int        @default(0)
  items MenuItem[]
}

model MenuItem {
  id          Int         @id @default(autoincrement())
  name        String
  description String?
  price       Float
  image       String?
  isAvailable Boolean     @default(true)
  categoryId  Int
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
}

model Order {
  id              Int         @id @default(autoincrement())
  tableId         Int
  table           Table       @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableName       String?
  status          String      @default("pending") // pending, cooking, ready, completed, paid, cancelled
  orderType       String      @default("dine-in") // dine-in, takeaway
  paymentStatus   String      @default("unpaid") // unpaid, paid, cancelled
  paymentMethod   String?     // cash, qr_code, card
  total           Float
  createdBy       Int?        // User ID của nhân viên tạo order
  createdByUser   User?       @relation("CreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  paidBy          Int?        // User ID của nhân viên thanh toán bill
  paidByUser     User?       @relation("PaidBy", fields: [paidBy], references: [id], onDelete: SetNull)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id         Int      @id @default(autoincrement())
  orderId    Int
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId Int
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  note       String?
  isServed   Boolean  @default(false)
  addedBy    Int?     // User ID của người thêm món (nhân viên)
  addedByUser User?   @relation("ItemAddedBy", fields: [addedBy], references: [id], onDelete: SetNull)
}

model CallRequest {
  id        Int      @id @default(autoincrement())
  tableId   Int
  table     Table    @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableName String?
  type      String   // e.g. 'Mật khẩu Wifi', 'Lấy thêm đá', 'Thanh toán'
  status    String   @default("pending") // pending, resolved
  createdAt DateTime @default(now())
}

model PaymentRequest {
  id        Int      @id @default(autoincrement())
  tableId   Int?
  table     Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableName String?
  method    String   // 'cash', 'transfer', 'card'
  note      String?
  status    String   @default("pending") // pending, completed, cancelled
  createdAt DateTime @default(now())
}

model Rating {
  id        Int      @id @default(autoincrement())
  tableId   Int?
  table     Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableName String?
  stars     Int      // 1-5
  note      String?
  status    String   @default("pending") // pending, reviewed
  createdAt DateTime @default(now())
}

model StaffCall {
  id        Int      @id @default(autoincrement())
  tableId   Int?
  table     Table?   @relation(fields: [tableId], references: [id], onDelete: Cascade)
  tableName String?
  message   String?
  status    String   @default("pending") // pending, completed
  createdAt DateTime @default(now())
}

model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique
  password  String
  name      String
  role      String   @default("staff") // "admin", "cashier", "kitchen" or "staff"
  createdAt DateTime @default(now())
  orders    Order[]  @relation("CreatedBy")
  paidOrders Order[] @relation("PaidBy")
  addedItems OrderItem[] @relation("ItemAddedBy")
}
